{
  "repository": "roctinam/aiwg",
  "reader_approle": "ci-aiwg",
  "bootstrap_tracker_secrets": [
    "BAO_CI_ROLE_ID",
    "BAO_CI_SECRET_ID"
  ],
  "tracker_variables": [
    "DEPLOY_HOST",
    "DEPLOY_PORT",
    "DEPLOY_USER",
    "DEPLOY_PATH"
  ],
  "leaves": [
    {
      "mount": "kv_internal",
      "path": "ci/aiwg/gitea-npm-token",
      "field": "token",
      "type": "api-token",
      "service": "ci/aiwg",
      "owner": "roctibot",
      "tenant": "internal",
      "purpose": "Gitea package publish, release creation, and release asset upload token for AIWG",
      "consumers": "gitea-actions:aiwg:npm-publish,gitea-release,upload-release-sigs",
      "reader_approle": "ci-aiwg",
      "sensitivity": "high",
      "rotation": "quarterly",
      "sop": "aiwg/docs/contributing/secret-rotation.md"
    },
    {
      "mount": "kv_internal",
      "path": "ci/aiwg/github-mirror-token",
      "field": "token",
      "type": "api-token",
      "service": "ci/aiwg",
      "owner": "roctibot",
      "tenant": "internal",
      "purpose": "GitHub mirror push and release creation token for AIWG",
      "consumers": "gitea-actions:aiwg:github-mirror",
      "reader_approle": "ci-aiwg",
      "sensitivity": "high",
      "rotation": "quarterly",
      "sop": "aiwg/docs/contributing/secret-rotation.md"
    },
    {
      "mount": "kv_internal",
      "path": "ci/aiwg/aiwg-io-dispatch-token",
      "field": "token",
      "type": "api-token",
      "service": "ci/aiwg",
      "owner": "roctibot",
      "tenant": "internal",
      "purpose": "aiwg.io deploy workflow dispatch token",
      "consumers": "gitea-actions:aiwg:notify-site",
      "reader_approle": "ci-aiwg",
      "sensitivity": "high",
      "rotation": "quarterly",
      "sop": "aiwg/docs/contributing/secret-rotation.md"
    },
    {
      "mount": "kv_internal",
      "path": "ci/shared/docs-deploy",
      "field": "private_key",
      "type": "ssh-private-key",
      "service": "ci/shared/docs-deploy",
      "owner": "itops",
      "tenant": "internal",
      "purpose": "Shared docs.aiwg.io deploy SSH private key",
      "consumers": "gitea-actions:aiwg:docsite-deploy",
      "reader_approle": "ci-aiwg",
      "sensitivity": "critical",
      "rotation": "on-exposure",
      "sop": "aiwg/docs/contributing/secret-rotation.md"
    }
  ],
  "policy": {
    "name": "ci-aiwg",
    "rules": [
      {
        "path": "kv_internal/data/ci/aiwg/*",
        "capabilities": [
          "read"
        ]
      },
      {
        "path": "kv_internal/metadata/ci/aiwg/*",
        "capabilities": [
          "read",
          "list"
        ]
      },
      {
        "path": "kv_internal/data/ci/shared/docs-deploy",
        "capabilities": [
          "read"
        ]
      },
      {
        "path": "kv_internal/metadata/ci/shared/docs-deploy",
        "capabilities": [
          "read"
        ]
      }
    ]
  }
}
