# AIWG project artifacts — tracked in git (except ephemeral content)
# .aiwg/ is NOT gitignored — it contains SDLC artifacts (ADRs, use cases, etc.)
# The following subdirectories are ephemeral and excluded:
.aiwg/aiwg.config
.aiwg/working/
.aiwg/.index/
.aiwg/.storage-cache/
.aiwg/security-engineering/reviews/disclosures/
.aiwg/ralph/archive/
.aiwg/ralph-external/loops/
.aiwg/.milestones.json
.aiwg/browser-allowlist.yaml
.aiwg/marketing/
.aiwg/issues/
.aiwg/forensics/
.aiwg/research/synthesis/
.aiwg/frameworks/*/

# Agent temporary files
_agent-temp/
docs/references/pdfs/*.pdf

# Test temp directories (created by file watcher tests)
test-temp-watch-*/
test/**/.tmp-*/

# AIWG — ignore only high-churn runtime subdirs, NOT .aiwg/ itself
.aiwg/ralph/
.aiwg/ralph-external/

# RLM working dir — `aiwg rlm-prep` writes per-host chunks/manifests with
# absolute paths; reproducible from re-running the command.
.rlm-prep/

# stale docs preview build target (active target is dist/aiwg-docs)
.docs-preview/
