# AIWG Release Configuration
#
# Project-specific rules consumed by the `flow-release` skill.
# Schema: agentic/code/frameworks/sdlc-complete/schemas/release.config.schema.yaml
#
# To override per-project, edit this file. To regenerate from defaults,
# delete it and rerun `aiwg discover release` (the flow-release skill will
# scaffold a fresh copy from the schema).

version: 1

# Project identity for release artifacts (commit messages, announcements, etc.).
project:
  name: aiwg
  display_name: AIWG
  repo_url: https://git.integrolabs.net/roctinam/aiwg
  mirror_url: https://github.com/jmagly/aiwg
  npm_package: aiwg

# Version policy. CalVer with no leading zeros per the `versioning` CRITICAL rule.
version_policy:
  format: calver           # calver | semver
  pattern: 'YYYY.M.PATCH'  # display only; loader validates against the rule
  tag_prefix: v
  channels:
    stable:                # `latest` dist-tag
      tag_format: 'v{YYYY}.{M}.{PATCH}'
      require_announcement: true
      require_changelog: true
      require_uat: true
    rc:                    # `next` dist-tag
      tag_format: 'v{YYYY}.{M}.{PATCH}-rc.{N}'
      require_announcement: false
      require_changelog: false
      require_uat: false
    beta:
      tag_format: 'v{YYYY}.{M}.{PATCH}-beta.{N}'
      require_announcement: false
      require_changelog: false
      require_uat: false
    alpha:
      tag_format: 'v{YYYY}.{M}.{PATCH}-alpha.{N}'
      require_announcement: false
      require_changelog: false
      require_uat: false
    nightly:
      tag_format: 'v{YYYY}.{M}.{PATCH}-nightly.{YYYYMMDD}'
      require_announcement: false
      require_changelog: false
      require_uat: false

# Gates — executed in order. Each gate has a hard_stop flag; when true,
# failure halts the release. When false, failure surfaces a warning but
# the flow continues.
gates:

  # Gate 1: Local build + test green.
  # `flow-release` runs each command, captures stdout/stderr, and asserts
  # the exit code matches `expect_exit`.
  - name: local-build-test
    hard_stop: true
    steps:
      - id: typecheck
        run: npx tsc --noEmit
        expect_exit: 0
      - id: unit-tests
        run: npm test
        expect_exit: 0
        tolerate_pre_existing_flakes:
          - test/integration/cli-perf.test.ts  # cold-start p50 flake under heavy host load
      - id: build
        run: npm run build:cli
        expect_exit: 0
      - id: uat
        run: npm run uat
        expect_exit: 0
        required_for_channels: [stable]

  # Gate 2: CI green on the release commit.
  # Polls Gitea Actions API; waits up to `timeout_seconds` for completion.
  - name: ci-green
    hard_stop: true
    tracker: gitea
    owner: roctinam
    repo: aiwg
    timeout_seconds: 600
    poll_interval_seconds: 30
    required_workflows:
      - ci.yml        # Test + Build job
      - validate.yml  # Plugin metadata + SKILL frontmatter validation

  # Gate 3: Documentation sync.
  # Invokes the `doc-sync` skill (orchestrated) with `code-to-docs` direction
  # and a guidance hint pulling in all agentic/code sources plus the full
  # repository Markdown corpus.
  - name: doc-sync
    hard_stop: true
    invoke_skill: doc-sync
    args:
      direction: code-to-docs
      scope: 'agentic/code/** **/*.md'
      guidance: |
        Audit the docs against the current implementation. Include every file
        under agentic/code/ plus all repository Markdown files because AIWG
        capability is primarily documented in skills, agents, commands,
        templates, behaviors, rules, manifests, and generated guidance.
        Treat agentic/code/ framework READMEs, agent definitions, skill bodies,
        addon manifests, command docs, templates, behavior bundles, and rules
        as authoritative documentation surfaces that must match the current
        implementation. Reconcile drift in:
          - command references (CLI handlers vs help text vs CLAUDE.md tables)
          - skill names and frontmatter (especially script: blocks added recently)
          - rule references (kernel rules list, no-attribution coverage, delivery-policy)
          - framework counts (agents/skills/commands/rules per manifest)
        Auto-fix small inconsistencies; flag larger drift for human review.
      dry_run_first: true

  # Gate 4: CHANGELOG + announcement.
  # For `stable` channel only — pre-release tags skip per CLAUDE.md release
  # channels guidance (internal pipeline checkpoints, not public releases).
  - name: changelog-and-announcement
    hard_stop: true
    required_for_channels: [stable]
    artifacts:
      - path: CHANGELOG.md
        section_pattern: '## [{version}]'    # must contain a section header for the target version
      - path: 'docs/releases/v{version}-announcement.md'
        must_exist: true

  # Gate 5: README freshness.
  # Surfaces a diff vs. last release commit; the operator confirms whether
  # any updates are required. Soft gate by default — many releases don't
  # need README changes, but the flow forces a conscious decision.
  - name: readme-freshness
    hard_stop: false
    review_diff:
      path: README.md
      since_tag: 'latest-stable'
      prompt: 'Has the README been reviewed for changes shipping in this release?'
    required_for_channels: [stable]

  # Gate 6: Tag, push, mirror, npm dist-tag.
  # cut-tag.sh sources the release-signing key from the configured vault
  # via the ci-aiwg AppRole into an
  # ephemeral keyring and signs with loopback pinentry — no local key needed.
  # Export VAULT_CI_ROLE_ID / VAULT_CI_SECRET_ID (operator credstore or CI
  # secrets) before this gate. See docs/contributing/versioning.md.
  - name: release
    hard_stop: true
    steps:
      - id: create-tag
        run: 'tools/release/cut-tag.sh {version}'
      - id: push-origin
        run: 'git push origin main --tags'
      - id: push-mirror
        run: 'git push github main --tags'
        skip_when_flag: '--no-mirror'
      - id: npm-dist-tag
        depends_on_channel:
          stable:  'npm dist-tag add aiwg@{version} latest'
          rc:      'npm dist-tag add aiwg@{version} next'
          beta:    'npm dist-tag add aiwg@{version} next'
          alpha:   'npm dist-tag add aiwg@{version} next'
          nightly: 'npm dist-tag add aiwg@{version} nightly'

  # Gate 7 (post-release): tracker close-outs + reporter thanks.
  - name: post-release
    hard_stop: false
    actions:
      - close_imported_issues_with_thanks: true   # mirror the jmagly→roctinam pattern
      - update_release_entry: gitea               # auto-create release if not present
      - update_release_entry: github              # only for stable channel
        skip_when_flag: '--no-mirror'

# Policy reminders applied at every gate (also enforced by their own rules).
policy:
  no_ai_attribution: true                    # rule: no-attribution
  ci_green_before_done: true                 # rule: ci-green-before-done
  preserve_pre_release_announcements: false  # rule: pre-release tags don't get announcements
  thank_external_reporters: true             # mirror the May-2026 import sweep pattern

# Channels-pipeline visualization (informational, not enforced):
# dev → nightly → alpha → beta → rc → stable
