{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/catalog/catalog.v1.schema.json",
  "title": "AIWG Schema Catalog Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domains"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "policy": { "$ref": "schema-artifact.v1.schema.json#/$defs/policy" },
    "domains": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "domain-manifest.v1.schema.json" }
        ]
      }
    }
  }
}
