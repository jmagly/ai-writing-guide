{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/marketplace/aiwg-marketplace-envelope.v1.schema.json",
  "title": "AIWG Git-native marketplace provenance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requiredCapabilities", "package", "source", "publisher", "publication", "provenance", "fortemi", "signatures"],
  "properties": {
    "schemaVersion": { "const": "aiwg.marketplace.provenance-envelope.v1" },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["immutable-git-v1", "w3c-prov-v1", "fortemi-full-v1", "offline-verification-v1"] }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name", "version", "type", "description", "license", "wrapperSchemaVersion", "wrapperVersion", "providers", "dependencies", "inventory"],
      "properties": {
        "namespace": { "$ref": "#/$defs/nonEmpty" },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "type": { "enum": ["framework", "addon", "extension", "plugin", "unknown"] },
        "description": { "type": "string" },
        "license": { "$ref": "#/$defs/nonEmpty" },
        "wrapperSchemaVersion": { "$ref": "#/$defs/nonEmpty" },
        "wrapperVersion": { "$ref": "#/$defs/nonEmpty" },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "support"],
            "properties": { "provider": { "$ref": "#/$defs/nonEmpty" }, "support": { "$ref": "#/$defs/nonEmpty" } }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identity", "version"],
            "properties": {
              "identity": { "$ref": "#/$defs/nonEmpty" },
              "version": { "$ref": "#/$defs/nonEmpty" },
              "lockId": { "$ref": "#/$defs/lockId" },
              "optional": { "type": "boolean" }
            }
          }
        },
        "inventory": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inventory" } },
        "sbom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "sha256", "path"],
          "properties": { "format": { "$ref": "#/$defs/nonEmpty" }, "sha256": { "$ref": "#/$defs/sha256" }, "path": { "$ref": "#/$defs/safePath" } }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalRemote", "requestedRef", "resolvedCommit", "gitTreeObject", "treeSha256", "artifactSha256", "wrapperPath", "payloadPath", "resolvedAt"],
      "properties": {
        "canonicalRemote": { "type": "string", "pattern": "^(https?://|ssh://|git@)" },
        "requestedRef": { "$ref": "#/$defs/nonEmpty" },
        "resolvedCommit": { "$ref": "#/$defs/gitObject" },
        "gitTreeObject": { "$ref": "#/$defs/gitObject" },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "wrapperPath": { "type": "string" },
        "payloadPath": { "type": "string" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "commitTime": { "type": "string", "format": "date-time" },
        "tag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "$ref": "#/$defs/nonEmpty" }, "object": { "$ref": "#/$defs/gitObject" }, "signed": { "type": "boolean" } }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/nonEmpty" }, "displayName": { "type": "string" }, "keyId": { "type": "string" } }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "publishedAt"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "supersedes": { "$ref": "#/$defs/lockId" },
        "deprecated": { "type": "boolean" },
        "yanked": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "fortemi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profile", "sourceSchemaVersion"],
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "profile": { "const": "full-v1" },
        "sourceSchemaVersion": { "const": "aiwg.fortemi.index.export.v2" }
      }
    },
    "signatures": { "type": "array", "items": { "$ref": "#/$defs/signature" } }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lockId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "safePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "mode", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "publicKey", "signedAt", "payloadSha256", "signature"],
      "properties": {
        "keyId": { "$ref": "#/$defs/nonEmpty" },
        "algorithm": { "const": "ed25519" },
        "publicKey": { "$ref": "#/$defs/nonEmpty" },
        "signedAt": { "type": "string", "format": "date-time" },
        "payloadSha256": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "entities", "activities", "agents", "relations"],
      "properties": {
        "standard": { "const": "W3C-PROV" },
        "entities": { "type": "array", "items": { "type": "object" } },
        "activities": { "type": "array", "items": { "type": "object" } },
        "agents": { "type": "array", "items": { "type": "object" } },
        "relations": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
