{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/marketplace/aiwg-marketplace-portable-bundle.v1.schema.json",
  "title": "Lossless offline AIWG marketplace package bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "envelope", "lock", "receipts", "fortemiShardBase64", "files"],
  "properties": {
    "schemaVersion": { "const": "aiwg.marketplace.portable-bundle.v1" },
    "envelope": { "$ref": "aiwg-marketplace-envelope.v1.schema.json" },
    "lock": { "$ref": "aiwg-marketplace-lock.v1.schema.json" },
    "receipts": { "type": "array", "minItems": 1, "items": { "$ref": "aiwg-marketplace-receipt.v1.schema.json" } },
    "fortemiShardBase64": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "mode", "sha256", "contentBase64"],
        "properties": {
          "path": { "$ref": "aiwg-marketplace-envelope.v1.schema.json#/$defs/safePath" },
          "bytes": { "type": "integer", "minimum": 0 },
          "mode": { "type": "integer", "minimum": 0, "maximum": 511 },
          "sha256": { "$ref": "aiwg-marketplace-envelope.v1.schema.json#/$defs/sha256" },
          "contentBase64": { "type": "string" }
        }
      }
    }
  }
}
