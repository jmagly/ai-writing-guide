{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/marketplace/aiwg-marketplace-catalog.v1.schema.json",
  "title": "Federated signed AIWG Git package catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "sequence", "generatedAt", "entries", "signatures"],
  "properties": {
    "schemaVersion": { "const": "aiwg.marketplace.catalog.v1" },
    "catalogId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "version", "description", "license", "canonicalRemote", "requestedRef", "resolvedCommit", "envelopePath", "envelopeSha256", "lockId", "publisher", "provenanceCompleteness", "verificationStatus"],
        "properties": {
          "identity": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "license": { "type": "string", "minLength": 1 },
          "canonicalRemote": { "type": "string", "minLength": 1 },
          "requestedRef": { "type": "string", "minLength": 1 },
          "resolvedCommit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
          "envelopePath": { "type": "string", "minLength": 1 },
          "envelopeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "lockId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "publisher": { "type": "string", "minLength": 1 },
          "provenanceCompleteness": { "type": "number", "minimum": 0, "maximum": 100 },
          "verificationStatus": { "enum": ["verified", "integrity-only", "untrusted", "failed"] },
          "deprecated": { "type": "boolean" },
          "yanked": { "type": "boolean" }
        }
      }
    },
    "signatures": { "type": "array", "minItems": 1, "items": { "$ref": "aiwg-marketplace-envelope.v1.schema.json#/$defs/signature" } }
  }
}
