{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/aiwg-fortemi-index-export.json",
  "title": "AIWG Fortemi Index Export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "aiwg.fortemi.index.export.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "privacy"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "privacy": {
      "enum": [
        "private",
        "sanitized",
        "public"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "type",
        "source",
        "title",
        "text",
        "facets",
        "tags",
        "concepts",
        "relationships",
        "provenance",
        "privacy",
        "updated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "aiwg.fortemi.index.record.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "crm.contact",
            "crm.organization",
            "crm.event",
            "crm.interaction",
            "aiwg.artifact"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "repo_relative_path",
            "locator"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "repo_relative_path": {
              "type": "string",
              "minLength": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "facets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target_id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "target_id": {
                "type": "string",
                "minLength": 1
              },
              "source_path": {
                "type": "string"
              }
            }
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "source",
              "path",
              "confidence",
              "privacy"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "source",
                  "candidate",
                  "reviewed",
                  "rejected"
                ]
              },
              "privacy": {
                "$ref": "#/$defs/privacy"
              }
            }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "pii"
          ],
          "properties": {
            "classification": {
              "$ref": "#/$defs/privacy"
            },
            "pii": {
              "type": "boolean"
            }
          }
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
