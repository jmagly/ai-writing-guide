# AIWG .npmrc — supply-chain hardening config
#
# This file is committed to the repo and applies to every `npm install` /
# `npm ci` invocation that runs with this directory as CWD (or any
# ancestor) — including CI workflows and contributor dev machines.
#
# See:
#   - docs/contributing/versioning.md § Release-age policy
#   - docs/contributing/dependency-sources.md § Lockfile regeneration
#   - .aiwg/architecture/adr-pnpm-workspace-migration.md (why .npmrc, not pnpm)
#   - Issue #1290 (A15 release-age gate)
#   - Issue #1278 (Wave 7 — Mini Shai-Hulud supply-chain hardening epic)
#
# REQUIREMENTS:
#   - npm 11.5+ (the `min-release-age` config was added in this release).
#     Node 20.20.2 / 22.x base images ship npm 10.x by default; CI
#     workflows must install npm@latest (or pinned npm@11.x) BEFORE running
#     `npm ci` for this gate to be honored.

# --- Release-age gate ---------------------------------------------------
# Refuse to install any dependency version published less than 7 days ago.
# Threat: brand-new-malicious-publish-window attacks (the Mini Shai-Hulud
# pattern, scenario S2 in docs/security/supply-chain-hardening-plan.md).
# A package compromised at publish time has its window-of-effective-attack
# bounded by this gate; the dependency-update workflow only rolls forward
# to versions that have survived public exposure for >= 7 days.
#
# Increase to 10 (or higher) for high-sensitivity publish workflows via
# the AIWG_MIN_RELEASE_AGE_HIGH env override pattern documented in
# docs/contributing/versioning.md.
min-release-age=7

# Registry config for private @matric scoped packages (used by tools/eval).
# Promoted from tools/eval/.npmrc so the workspace-root .npmrc covers it
# for any future workspace-aware tooling. tools/eval/.npmrc stays in place
# for npm's per-package resolution path.
@matric:registry=https://git.integrolabs.net/api/packages/roctinam/npm/
