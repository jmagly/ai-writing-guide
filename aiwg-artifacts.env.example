# AIWG maintainer corpus bridge.
#
# Copy or source this file when working on AIWG's own private SDLC corpus from
# an adjacent checkout:
#
#   source aiwg-artifacts.env.example
#
# The directory itself lives in the private roctinam/aiwg-web-release-ops repo.
# Public clones do not need this for normal build/test workflows.

export AIWG_ARTIFACTS_PATH="${AIWG_ARTIFACTS_PATH:-../aiwg-web-release-ops/corpus/.aiwg}"
