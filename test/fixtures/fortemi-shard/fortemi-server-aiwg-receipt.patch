+    #[tokio::test]
+    async fn aiwg_core_v1_external_fixture_clean_import_reexport() {
+        let _shard_test_guard = SHARD_INTEGRATION_TEST_LOCK.lock().await;
+        let fixture = std::env::var("AIWG_SHARD_FIXTURE")
+            .expect("AIWG_SHARD_FIXTURE must name the immutable AIWG archive");
+        let shard = std::fs::read(fixture).expect("read AIWG shard fixture");
+        let database_url = std::env::var("DATABASE_URL")
+            .unwrap_or_else(|_| "postgres://matric:matric@localhost/matric".to_string());
+        let db = Database::connect(&database_url)
+            .await
+            .expect("connect integration database");
+        db.migrate().await.expect("migrate clean integration database");
+        let archive_name = format!("aiwg-shard-{}", Uuid::new_v4().simple());
+        let destination = db
+            .archives
+            .create_archive_schema(&archive_name, Some("AIWG core-v1 consumer receipt"))
+            .await
+            .expect("create isolated AIWG destination");
+        let state = build_call_api_test_state(db.clone(), &database_url).await;
+        let opts = ShardImportOptions {
+            include: None,
+            dry_run: false,
+            on_conflict: ConflictStrategy::Replace,
+            skip_embedding_regen: true,
+        };
+
+        let before = db
+            .for_schema(&destination.schema_name)
+            .unwrap()
+            .query(|tx| Box::pin(async move {
+                sqlx::query_scalar::<_, i64>("SELECT COUNT(*) FROM note")
+                    .fetch_one(&mut **tx)
+                    .await
+                    .map_err(matric_db::Error::Database)
+            }))
+            .await
+            .expect("count clean destination");
+        assert_eq!(before, 0);
+
+        let imported = knowledge_shard_import_internal(
+            &state,
+            &shard,
+            &opts,
+            &destination.schema_name,
+        )
+        .await
+        .expect("import canonical AIWG core-v1 fixture");
+        assert_eq!(imported.imported.notes, 2);
+        assert_eq!(imported.imported.links, 2);
+
+        let export = knowledge_shard(
+            State(state.clone()),
+            Extension(ArchiveContext {
+                schema: destination.schema_name.clone(),
+                is_default: false,
+                name: Some(archive_name.clone()),
+            }),
+            Query(ShardExportQuery {
+                profile: Some("core-v1".to_string()),
+                include: None,
+                include_blobs: false,
+            }),
+        )
+        .await
+        .expect("re-export imported AIWG shard")
+        .into_response();
+        assert_eq!(export.status(), StatusCode::OK);
+        let exported = axum::body::to_bytes(export.into_body(), usize::MAX)
+            .await
+            .expect("read AIWG re-export");
+        let files = read_shard_archive(&exported, ShardArchiveLimits::default()).unwrap();
+        let manifest = parse_and_validate_shard_manifest(&files["manifest.json"]).unwrap();
+        assert_eq!(manifest.profile.as_deref(), Some("core-v1"));
+        let notes = parse_shard_component_records("notes", &files["notes.jsonl"]).unwrap();
+        let source = notes.iter().find_map(|note| {
+            note.pointer("/metadata/aiwg_fortemi_index/record")
+                .filter(|record| record.pointer("/source/checksum") == Some(&serde_json::json!("abc123")))
+        }).expect("preserved AIWG source record");
+        assert_eq!(source.pointer("/privacy/classification"), Some(&serde_json::json!("sanitized")));
+        assert_eq!(source.pointer("/relationships/0/type"), Some(&serde_json::json!("depends-on")));
+        assert!(source.pointer("/chunks/0/text").is_some());
+        assert!(source.pointer("/provenance/0/source").is_some());
+        assert!(source.pointer("/skos_concepts/0/id").is_some());
+
+        db.archives
+            .drop_archive_schema(&archive_name)
+            .await
+            .expect("drop isolated AIWG destination");
+    }
+
