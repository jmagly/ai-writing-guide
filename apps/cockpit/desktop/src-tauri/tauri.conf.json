{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIWG Cockpit",
  "version": "0.0.0",
  "identifier": "io.aiwg.cockpit",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'none'; frame-src 'self'; style-src 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
