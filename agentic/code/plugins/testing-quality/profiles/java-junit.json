{
  "schemaVersion": 1,
  "id": "java-junit",
  "name": "Java JUnit/Maven",
  "status": "researched-not-qualified",
  "compatibility": "not-verified",
  "assumptions": [
    "TODO: select each module Surefire/Failsafe report or canonical aggregator. XML stdout is not assumed; inspect engines/POM and report paths.",
    "TODO: review candidate scope, thresholds, skips, report adapter and minimum test obligations before execution."
  ],
  "protocolSpec": {
    "platform": "java-junit",
    "system": "TODO: identify actual system and source or installed-artifact boundary",
    "source": {
      "include": [
        "src/main/java/**/*.java"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**",
        "src/test/java/**/*.java"
      ]
    },
    "tests": {
      "include": [
        "src/test/java/**/*.java"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**"
      ]
    },
    "areas": [
      {
        "id": "tests",
        "include": [
          "src/test/java/**/*.java"
        ]
      }
    ],
    "lanes": [
      {
        "id": "default",
        "runner": "junit",
        "include": [
          "src/test/java/**/*.java"
        ],
        "exclude": [
          "**/node_modules/**",
          "**/.git/**",
          "**/.aiwg/**",
          "**/dist/**",
          "**/build/**",
          "**/coverage/**",
          "**/.venv/**",
          "**/venv/**",
          "**/target/**",
          "**/bin/**",
          "**/obj/**",
          "**/__pycache__/**"
        ],
        "command": {
          "argv": [
            "mvn",
            "--offline",
            "verify",
            "-DfailIfNoTests=true"
          ],
          "timeoutMs": 300000
        },
        "result": {
          "format": "junit"
        },
        "required": true,
        "negativeControls": [],
        "versionCommand": [
          "mvn",
          "--version"
        ]
      }
    ],
    "policy": {
      "requireDiscovery": true,
      "requireReview": true,
      "requireNegativeControls": true,
      "allowSkipped": false,
      "coverageThresholds": {},
      "maxFiles": 100000,
      "maxFileBytes": 1048576,
      "maxOutputBytes": 10485760
    },
    "research": {
      "paths": [
        ".aiwg/research/findings",
        ".aiwg/research/synthesis",
        ".aiwg/research/knowledge"
      ],
      "allowWeb": false
    }
  },
  "templates": [
    {
      "source": "templates/platforms/java-junit/BoundaryExampleTest.java",
      "destination": ".aiwg/testing/conformance/examples/java-junit/BoundaryExampleTest.java",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    },
    {
      "source": "templates/platforms/java-junit/RESEARCH.md",
      "destination": ".aiwg/testing/conformance/examples/java-junit/RESEARCH.md",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    },
    {
      "source": "templates/platforms/java-junit/protocol.example.json",
      "destination": ".aiwg/testing/conformance/examples/java-junit/protocol.example.json",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    },
    {
      "source": "templates/platforms/java-junit/test-review.example.md",
      "destination": ".aiwg/testing/conformance/examples/java-junit/test-review.example.md",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    }
  ]
}
