{
  "apiVersion": "testing.aiwg.io/v1",
  "kind": "TestConformanceProtocol",
  "metadata": {
    "name": "python-pytest-example",
    "description": "TODO assumptions: Select the project interpreter/virtualenv and qualified JUnit adapter; collection imports code."
  },
  "spec": {
    "platform": "python-pytest",
    "system": "TODO: identify actual system and source or installed-artifact boundary",
    "source": {
      "include": [
        "src/**/*.py"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**",
        "**/test_*.py",
        "**/*_test.py"
      ]
    },
    "tests": {
      "include": [
        "**/test_*.py",
        "**/*_test.py"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**"
      ]
    },
    "areas": [
      {
        "id": "tests",
        "include": [
          "**/test_*.py",
          "**/*_test.py"
        ]
      }
    ],
    "lanes": [
      {
        "id": "default",
        "runner": "pytest",
        "include": [
          "**/test_*.py",
          "**/*_test.py"
        ],
        "exclude": [
          "**/node_modules/**",
          "**/.git/**",
          "**/.aiwg/**",
          "**/dist/**",
          "**/build/**",
          "**/coverage/**",
          "**/.venv/**",
          "**/venv/**",
          "**/target/**",
          "**/bin/**",
          "**/obj/**",
          "**/__pycache__/**"
        ],
        "command": {
          "argv": [
            "python3",
            ".aiwg/testing/conformance/adapters/pytest_reporter.py",
            "--mode",
            "execution",
            "--output",
            ".aiwg/testing/conformance/raw/{runId}/pytest-execution.json"
          ],
          "timeoutMs": 300000
        },
        "result": {
          "format": "canonical",
          "path": ".aiwg/testing/conformance/raw/{runId}/pytest-execution.json"
        },
        "required": true,
        "negativeControls": [],
        "versionCommand": [
          "python3",
          "-m",
          "pytest",
          "--version"
        ],
        "discovery": {
          "command": {
            "argv": [
              "python3",
              ".aiwg/testing/conformance/adapters/pytest_reporter.py",
              "--mode",
              "discovery",
              "--output",
              ".aiwg/testing/conformance/raw/{runId}/pytest-discovery.json"
            ],
            "timeoutMs": 300000
          },
          "result": {
            "format": "canonical",
            "path": ".aiwg/testing/conformance/raw/{runId}/pytest-discovery.json"
          }
        }
      }
    ],
    "policy": {
      "requireDiscovery": true,
      "requireReview": true,
      "requireNegativeControls": true,
      "allowSkipped": false,
      "coverageThresholds": {},
      "maxFiles": 100000,
      "maxFileBytes": 1048576,
      "maxOutputBytes": 10485760
    },
    "research": {
      "paths": [
        ".aiwg/research/findings",
        ".aiwg/research/synthesis",
        ".aiwg/research/knowledge"
      ],
      "allowWeb": false
    },
    "configFiles": [
      ".aiwg/testing/conformance/adapters/pytest_reporter.py"
    ]
  }
}
