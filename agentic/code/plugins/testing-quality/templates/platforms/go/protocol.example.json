{
  "apiVersion": "testing.aiwg.io/v1",
  "kind": "TestConformanceProtocol",
  "metadata": {
    "name": "go-example",
    "description": "TODO assumptions: List discovery omits dynamic subtests; approve package/build-tag/GOOS scope and statement coverage units."
  },
  "spec": {
    "platform": "go",
    "system": "TODO: identify actual system and source or installed-artifact boundary",
    "source": {
      "include": [
        "**/*.go"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**",
        "**/*_test.go"
      ]
    },
    "tests": {
      "include": [
        "**/*_test.go"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**"
      ]
    },
    "areas": [
      {
        "id": "tests",
        "include": [
          "**/*_test.go"
        ]
      }
    ],
    "lanes": [
      {
        "id": "default",
        "runner": "go",
        "include": [
          "**/*_test.go"
        ],
        "exclude": [
          "**/node_modules/**",
          "**/.git/**",
          "**/.aiwg/**",
          "**/dist/**",
          "**/build/**",
          "**/coverage/**",
          "**/.venv/**",
          "**/venv/**",
          "**/target/**",
          "**/bin/**",
          "**/obj/**",
          "**/__pycache__/**"
        ],
        "command": {
          "argv": [
            "go",
            "test",
            "-json",
            "-count=1",
            "./..."
          ],
          "timeoutMs": 300000
        },
        "result": {
          "format": "go-json"
        },
        "required": true,
        "negativeControls": [],
        "versionCommand": [
          "go",
          "version"
        ]
      }
    ],
    "policy": {
      "requireDiscovery": true,
      "requireReview": true,
      "requireNegativeControls": true,
      "allowSkipped": false,
      "coverageThresholds": {},
      "maxFiles": 100000,
      "maxFileBytes": 1048576,
      "maxOutputBytes": 10485760
    },
    "research": {
      "paths": [
        ".aiwg/research/findings",
        ".aiwg/research/synthesis",
        ".aiwg/research/knowledge"
      ],
      "allowWeb": false
    }
  }
}
