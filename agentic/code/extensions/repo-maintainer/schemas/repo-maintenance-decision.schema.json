{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/ops/repo-maintainer/v1/repo-maintenance-decision.schema.json",
  "title": "RepoMaintenanceDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "repo-maintainer.ops.aiwg.io/v1" },
    "kind": { "const": "RepoMaintenanceDecision" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "actor", "intent", "outcome"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "repository"],
          "properties": {
            "provider": { "enum": ["github", "gitea", "local"] },
            "repository": { "type": "string", "minLength": 1 },
            "remote": { "type": "string" }
          }
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["detectedTier"],
          "properties": {
            "login": { "type": "string" },
            "detectedTier": { "$ref": "#/definitions/tier" },
            "overrideSource": { "type": "string" }
          }
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "minimumTier"],
          "properties": {
            "action": { "type": "string", "minLength": 1 },
            "minimumTier": { "$ref": "#/definitions/tier" }
          }
        },
        "threatAssessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["surface", "mode", "profile", "policyVersion", "profileVersion", "policyHash", "policyProvenance", "action", "wouldAction", "severity"],
          "properties": {
            "surface": {
              "enum": ["issue-title", "issue-body", "issue-comment", "pull-request-title", "pull-request-body", "pull-request-diff-summary", "review-comment", "release-note", "handoff", "outbound-maintainer-comment"]
            },
            "mode": {
              "enum": ["off", "audit", "enforce"]
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "policyVersion": {
              "type": "string",
              "minLength": 1
            },
            "profileVersion": {
              "type": "string",
              "minLength": 1
            },
            "policyHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "policyProvenance": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "$ref": "#/definitions/threatAction"
            },
            "wouldAction": {
              "$ref": "#/definitions/threatAction"
            },
            "severity": {
              "enum": ["informational", "low", "moderate", "high", "critical"]
            },
            "verdict": {
              "enum": ["safe", "flag", "reject"],
              "description": "Optional compatibility verdict for issue-oriented consumers."
            },
            "ruleIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "statementIds": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "effectiveAction"],
          "properties": {
            "mode": { "enum": ["executed", "degraded", "blocked"] },
            "effectiveAction": { "type": "string", "minLength": 1 },
            "reason": { "type": "string" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "references": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "tier": { "enum": ["collaborator", "maintainer", "admin"] },
    "threatAction": { "enum": ["proceed", "record", "flag", "require-authorization", "reject"] }
  }
}
