{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/ops/stream/v1/stream-artifacts.schema.json",
  "title": "Streaming operations extension artifacts",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "stream.ops.aiwg.io/v1" },
    "kind": { "enum": ["StreamEncoderConfig", "StreamPipeline"] },
    "metadata": { "$ref": "#/definitions/metadata" },
    "spec": { "type": "object", "additionalProperties": true }
  },
  "definitions": {
    "metadata": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "namespace": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
