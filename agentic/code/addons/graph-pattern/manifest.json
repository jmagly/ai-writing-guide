{
  "id": "graph-pattern",
  "type": "addon",
  "name": "Flow Graph Pattern",
  "version": "2026.8.0",
  "description": "Optional graph.flow.aiwg.io profile, validator, planner, fixtures, and operator guidance over AIWG Flow.",
  "core": false,
  "autoInstall": false,
  "author": "AIWG Contributors",
