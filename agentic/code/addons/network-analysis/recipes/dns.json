{
  "schema_version": "network-analysis.analysis-recipe/v1", "kind": "AnalysisRecipe", "recipe_id": "analysis-recipe:dns-v1", "version": "1.0.0",
  "title": "DNS queries, responses, latency, failures, and patterns", "purpose": "Inspect DNS metadata and label pattern-based security hypotheses separately from observed messages.", "sensitivity": "restricted",
  "inputs": { "capture_formats": ["pcap", "pcapng"], "live_capture": { "allowed": false }, "required_authorization_refs": ["authorization:saved-capture-review"] },
  "filters": { "capture_filters": [], "display_filters": [{ "type": "display_filter", "language": "wireshark-display", "expression": "dns", "applied_after_capture": true }] },
  "requested_output": {
    "fields": [{ "name": "frame.number", "required": true }, { "name": "frame.time_epoch", "required": true }, { "name": "ip.src", "required": false }, { "name": "ip.dst", "required": false }, { "name": "ipv6.src", "required": false }, { "name": "ipv6.dst", "required": false }, { "name": "udp.stream", "required": false }, { "name": "tcp.stream", "required": false }, { "name": "dns.id", "required": true }, { "name": "dns.qry.name", "required": false }, { "name": "dns.qry.type", "required": false }, { "name": "dns.flags.response", "required": true }, { "name": "dns.flags.rcode", "required": false }, { "name": "dns.time", "required": false }],
    "statistics": [{ "name": "dns-query-response-counts", "tool": "tshark", "required": true }], "artifact_media_types": ["application/json", "text/markdown"], "observation_policy": "separate-observations-and-inferences"
  },
  "limits": { "max_capture_bytes": 268435456, "max_frames": 100000, "max_duration_seconds": 300, "max_output_bytes": 33554432, "max_processes": 1, "payload_policy": "metadata-only" },
  "expected_output": { "packet_evidence_schema": "network-analysis.packet-evidence/v1", "required_citation_locators": ["frame", "stream"], "confidence_vocabulary": ["observed", "high", "probable", "possible", "unknown"] },
  "interpretation": { "observations": ["Query names/types, response codes, transaction IDs, and response timing are observations when present."], "heuristics": [{ "id": "dns-beacon-or-tunnel", "statement": "Repeated timing or high-entropy labels may warrant DNS command-and-control review.", "method": "Measure inter-arrival regularity and label length/entropy, then compare with the environment baseline.", "false_positive_conditions": ["CDNs, telemetry, service discovery, anti-abuse tokens, and endpoint management can create long or periodic queries."], "attack_techniques": ["T1071.004"] }] },
  "compatibility": { "contract": "network-analysis.analysis-recipe/v1", "minimum_tools": [{ "name": "tshark", "version_range": ">=4.4.0 <4.7.0", "required": true }], "field_fallbacks": [{ "field": "dns.time", "introduced_in": "4.4.0", "behavior": "omit-optional", "diagnostic": "DNS response-time field is unavailable; calculate bounded paired timing from transaction ID and frame timestamps or report it unavailable." }], "unsupported_major_policy": "fail-closed" },
  "extension_points": [{ "name": "suricata-alert-correlation", "status": "reserved", "contract": "network-analysis.suricata-adapter/v1" }]
}
