{
  "schema_version": "network-analysis.analysis-recipe/v1", "kind": "AnalysisRecipe", "recipe_id": "analysis-recipe:before-after-v1", "version": "1.0.0",
  "title": "Before and after capture comparison", "purpose": "Normalize two independently governed capture summaries for a bounded change comparison and explicit incomparability reporting.", "sensitivity": "restricted",
  "inputs": { "capture_formats": ["pcap", "pcapng"], "live_capture": { "allowed": false }, "required_authorization_refs": ["authorization:before-capture-review", "authorization:after-capture-review"] },
  "filters": { "capture_filters": [], "display_filters": [{ "type": "display_filter", "language": "wireshark-display", "expression": "frame", "applied_after_capture": true }] },
  "requested_output": {
    "fields": [{ "name": "frame.number", "required": true }, { "name": "frame.time_epoch", "required": true }, { "name": "frame.len", "required": true }, { "name": "ip.src", "required": false }, { "name": "ip.dst", "required": false }, { "name": "ipv6.src", "required": false }, { "name": "ipv6.dst", "required": false }, { "name": "tcp.stream", "required": false }, { "name": "udp.stream", "required": false }, { "name": "dns.qry.name", "required": false }, { "name": "tls.handshake.extensions_server_name", "required": false }, { "name": "http.host", "required": false }],
    "statistics": [{ "name": "normalized-before-after-delta", "tool": "custom", "required": true }], "artifact_media_types": ["application/json", "text/markdown"], "observation_policy": "separate-observations-and-inferences"
  },
  "limits": { "max_capture_bytes": 536870912, "max_frames": 200000, "max_duration_seconds": 600, "max_output_bytes": 67108864, "max_processes": 2, "payload_policy": "metadata-only" },
  "expected_output": { "packet_evidence_schema": "network-analysis.packet-evidence/v1", "required_citation_locators": ["frame", "stream"], "confidence_vocabulary": ["observed", "high", "probable", "possible", "unknown"] },
  "interpretation": { "observations": ["Each side retains its own capture digest, frame locators, tool context, timing, filters, topology notes, and observed summary values."], "heuristics": [{ "id": "change-effect", "statement": "A measured difference may be associated with the declared change when measurement conditions are comparable.", "method": "Compare normalized rates and distributions only after checking duration, topology, clocks, filters, load, capture point, and missing/encrypted traffic.", "false_positive_conditions": ["Traffic mix, client load, routing, clock drift, capture loss, asymmetric visibility, cache state, and unrelated deployments can create differences."], "attack_techniques": [] }] },
  "compatibility": { "contract": "network-analysis.analysis-recipe/v1", "minimum_tools": [{ "name": "tshark", "version_range": ">=4.4.0 <4.7.0", "required": true }, { "name": "capinfos", "version_range": ">=4.4.0 <4.7.0", "required": false }], "field_fallbacks": [{ "field": "tls.handshake.extensions_server_name", "introduced_in": "4.4.0", "behavior": "omit-optional", "diagnostic": "SNI is unavailable or encrypted; compare only remaining common fields and record reduced comparability." }], "unsupported_major_policy": "fail-closed" },
  "extension_points": []
}
