{
  "schema_version": "network-analysis.analysis-recipe/v1", "kind": "AnalysisRecipe", "recipe_id": "analysis-recipe:beaconing-timing-v1", "version": "1.0.0",
  "title": "Beaconing and timing indicators", "purpose": "Measure bounded stream timing and expose periodicity hypotheses with baseline and false-positive requirements.", "sensitivity": "restricted",
  "inputs": { "capture_formats": ["pcap", "pcapng"], "live_capture": { "allowed": false }, "required_authorization_refs": ["authorization:saved-capture-review"] },
  "filters": { "capture_filters": [], "display_filters": [{ "type": "display_filter", "language": "wireshark-display", "expression": "tcp || udp || dns || http", "applied_after_capture": true }] },
  "requested_output": {
    "fields": [{ "name": "frame.number", "required": true }, { "name": "frame.time_epoch", "required": true }, { "name": "frame.len", "required": true }, { "name": "ip.src", "required": false }, { "name": "ip.dst", "required": false }, { "name": "ipv6.src", "required": false }, { "name": "ipv6.dst", "required": false }, { "name": "tcp.stream", "required": false }, { "name": "udp.stream", "required": false }, { "name": "dns.qry.name", "required": false }, { "name": "http.host", "required": false }],
    "statistics": [{ "name": "inter-arrival-distribution", "tool": "custom", "required": true }], "artifact_media_types": ["application/json", "text/markdown"], "observation_policy": "separate-observations-and-inferences"
  },
  "limits": { "max_capture_bytes": 268435456, "max_frames": 100000, "max_duration_seconds": 300, "max_output_bytes": 33554432, "max_processes": 2, "payload_policy": "metadata-only" },
  "expected_output": { "packet_evidence_schema": "network-analysis.packet-evidence/v1", "required_citation_locators": ["frame", "stream"], "confidence_vocabulary": ["observed", "high", "probable", "possible", "unknown"] },
  "interpretation": { "observations": ["Frame timestamps, lengths, peers, and context-bound stream membership are observations."], "heuristics": [{ "id": "periodic-beacon", "statement": "A conversation may exhibit unusually regular inter-arrival timing.", "method": "Require at least five intervals, report count/median/deviation, and compare with an operator-supplied baseline before labeling possible beaconing.", "false_positive_conditions": ["Health checks, telemetry, keepalives, scheduled jobs, NTP, DNS refresh, and retry timers are intentionally periodic."], "attack_techniques": ["T1071.001", "T1071.004"] }] },
  "compatibility": { "contract": "network-analysis.analysis-recipe/v1", "minimum_tools": [{ "name": "tshark", "version_range": ">=4.4.0 <4.7.0", "required": true }], "field_fallbacks": [], "unsupported_major_policy": "fail-closed" },
  "extension_points": [{ "name": "zeek-enrichment", "status": "reserved", "contract": "network-analysis.zeek-adapter/v1" }]
}
