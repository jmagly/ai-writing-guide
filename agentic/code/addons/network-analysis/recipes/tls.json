{
  "schema_version": "network-analysis.analysis-recipe/v1", "kind": "AnalysisRecipe", "recipe_id": "analysis-recipe:tls-v1", "version": "1.0.0",
  "title": "TLS handshake metadata and failures", "purpose": "Inspect TLS handshake types, SNI, certificate metadata, versions, ciphers, alerts, and failure indicators without keys or payload.", "sensitivity": "restricted",
  "inputs": { "capture_formats": ["pcap", "pcapng"], "live_capture": { "allowed": false }, "required_authorization_refs": ["authorization:saved-capture-review"] },
  "filters": { "capture_filters": [], "display_filters": [{ "type": "display_filter", "language": "wireshark-display", "expression": "tls", "applied_after_capture": true }] },
  "requested_output": {
    "fields": [{ "name": "frame.number", "required": true }, { "name": "frame.time_epoch", "required": true }, { "name": "tcp.stream", "required": true }, { "name": "tls.handshake.type", "required": false }, { "name": "tls.handshake.extensions_server_name", "required": false }, { "name": "tls.handshake.version", "required": false }, { "name": "tls.handshake.ciphersuite", "required": false }, { "name": "x509af.serialNumber", "required": false }, { "name": "x509ce.dNSName", "required": false }, { "name": "tls.alert_message.desc", "required": false }],
    "statistics": [{ "name": "tls-handshake-counts", "tool": "tshark", "required": false }], "artifact_media_types": ["application/json", "text/markdown"], "observation_policy": "separate-observations-and-inferences"
  },
  "limits": { "max_capture_bytes": 268435456, "max_frames": 100000, "max_duration_seconds": 300, "max_output_bytes": 33554432, "max_processes": 1, "payload_policy": "metadata-only" },
  "expected_output": { "packet_evidence_schema": "network-analysis.packet-evidence/v1", "required_citation_locators": ["frame", "stream"], "confidence_vocabulary": ["observed", "high", "probable", "possible", "unknown"] },
  "interpretation": { "observations": ["Handshake message types, advertised SNI, negotiated metadata, certificate bytes interpreted by TShark, and alerts are observations."], "heuristics": [{ "id": "encrypted-channel-review", "statement": "An encrypted channel may warrant review when it differs from the declared service baseline.", "method": "Compare SNI, certificate identity, version, cipher, peer, timing, and alerts with authorized service expectations.", "false_positive_conditions": ["Ordinary HTTPS, privacy relays, service meshes, certificate rotation, and middleboxes commonly create encrypted or unusual-looking sessions."], "attack_techniques": ["T1573"] }] },
  "compatibility": { "contract": "network-analysis.analysis-recipe/v1", "minimum_tools": [{ "name": "tshark", "version_range": ">=4.4.0 <4.7.0", "required": true }], "field_fallbacks": [{ "field": "tls.handshake.extensions_server_name", "introduced_in": "4.4.0", "behavior": "omit-optional", "diagnostic": "SNI field is unavailable or encrypted; continue without inventing a server name and record the limitation." }], "unsupported_major_policy": "fail-closed" },
  "extension_points": [{ "name": "suricata-alert-correlation", "status": "reserved", "contract": "network-analysis.suricata-adapter/v1" }]
