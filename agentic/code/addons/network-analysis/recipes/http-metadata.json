{
  "schema_version": "network-analysis.analysis-recipe/v1", "kind": "AnalysisRecipe", "recipe_id": "analysis-recipe:http-metadata-v1", "version": "1.0.0",
  "title": "HTTP request and response metadata", "purpose": "Inspect HTTP method, host, status, timing, and stream metadata while excluding headers that carry credentials and all bodies.", "sensitivity": "restricted",
  "inputs": { "capture_formats": ["pcap", "pcapng"], "live_capture": { "allowed": false }, "required_authorization_refs": ["authorization:saved-capture-review"] },
  "filters": { "capture_filters": [], "display_filters": [{ "type": "display_filter", "language": "wireshark-display", "expression": "http.request || http.response", "applied_after_capture": true }] },
  "requested_output": {
    "fields": [{ "name": "frame.number", "required": true }, { "name": "frame.time_epoch", "required": true }, { "name": "tcp.stream", "required": true }, { "name": "http.request.method", "required": false }, { "name": "http.host", "required": false }, { "name": "http.response.code", "required": false }, { "name": "http.time", "required": false }],
    "statistics": [{ "name": "http-request-response-counts", "tool": "tshark", "required": false }], "artifact_media_types": ["application/json", "text/markdown"], "observation_policy": "separate-observations-and-inferences"
  },
  "limits": { "max_capture_bytes": 268435456, "max_frames": 100000, "max_duration_seconds": 300, "max_output_bytes": 33554432, "max_processes": 1, "payload_policy": "metadata-only" },
  "expected_output": { "packet_evidence_schema": "network-analysis.packet-evidence/v1", "required_citation_locators": ["frame", "stream"], "confidence_vocabulary": ["observed", "high", "probable", "possible", "unknown"] },
  "interpretation": { "observations": ["Method, host, response code, response timing, and stream identity are observations when decoded; cookies, authorization, URIs, headers, and bodies are excluded."], "heuristics": [{ "id": "web-protocol-review", "statement": "Periodic or baseline-divergent HTTP metadata may warrant command-and-control review.", "method": "Compare peer, host, method/status mix, timing, and volume with authorized application behavior.", "false_positive_conditions": ["Health checks, telemetry, polling clients, CDNs, proxies, and automated updates are commonly periodic."], "attack_techniques": ["T1071.001"] }] },
  "compatibility": { "contract": "network-analysis.analysis-recipe/v1", "minimum_tools": [{ "name": "tshark", "version_range": ">=4.4.0 <4.7.0", "required": true }], "field_fallbacks": [{ "field": "http.time", "introduced_in": "4.4.0", "behavior": "omit-optional", "diagnostic": "HTTP response-time field is unavailable; preserve frame times and report response latency unavailable." }], "unsupported_major_policy": "fail-closed" },
  "extension_points": []
}
