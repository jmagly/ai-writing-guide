{
  "id": "composition-engine",
  "type": "addon",
  "name": "Composition Engine",
  "version": "2026.8.0",
  "description": "Provider-neutral Flow graph composition contracts, validation, execution, and conformance tooling.",
  "core": false,
  "autoInstall": false,
  "author": "AIWG Contributors",
  "license": "MIT",
  "repository": "https://github.com/jmagly/aiwg",
  "keywords": [
    "composition",
    "flow",
    "graph",
    "orchestration",
    "provider-neutral",
    "validation"
  ],
  "entry": {
    "commands": "commands/",
    "skills": "skills/",
    "schemas": "schemas/",
    "fixtures": "fixtures/",
    "docs": "docs/",
    "examples": "examples/",
    "benchmarks": "benchmarks/",
    "evidence": "evidence/"
  },
  "agents": [],
  "commands": [],
  "skills": ["composition-validate", "composition-evaluate", "polyrhythmic-reasoning"],
  "schemas": ["flow-graph.schema"],
  "fixtures": [
    "linear-flow",
    "parallel-fanout",
    "agent-tool-flow",
    "phased-multi-track",
    "lcm-4x5",
    "polyrhythmic-strict-lcm",
    "polyrhythmic-adaptive",
    "human-decision-cycle"
  ],
  "examples": [
    "polyrhythmic-technical-troubleshooting",
    "polyrhythmic-conceptual-explanation",
    "polyrhythmic-practical-planning",
    "polyrhythmic-theoretical-comparison",
    "polyrhythmic-safety-policy"
  ],
  "benchmarks": ["composition-policy-benchmark.v1"],
  "evidence": [
    "composition-policy-benchmark-v1.raw",
    "composition-policy-benchmark-v1.summary"
  ],
  "cli_commands": {
    "namespace": "composition",
    "description": "Validate and execute provider-neutral Flow graphs; installed contracts: schemas/flow-graph.schema.json, fixtures/, examples/",
    "entry": "commands/",
    "subcommands": {
      "validate": {
        "file": "composition.mjs",
        "description": "Validate and normalize one FlowGraph manifest"
      },
      "example": {
        "file": "composition-example.mjs",
        "description": "Print or copy a shipped, validated FlowGraph example"
      },
      "run": {
        "file": "composition-run.mjs",
        "description": "Execute one validated FlowGraph through an explicit adapter"
      },
      "benchmark": {
        "file": "composition-benchmark.mjs",
        "description": "Evaluate fixed composition policies and emit raw records plus a claim-gated summary"
      }
    }
  },
  "dependencies": {
    "required": ["aiwg-utils"],
    "optional": ["mission-control", "orchestration-topology-lab"]
  },
  "flowProfile": {
    "apiVersion": "flow.aiwg.io/v1alpha1",
    "kind": "FlowGraph",
    "baseApiVersion": "flow.aiwg.io/v1",
    "baseKind": "FlowPlaybook"
  },
  "researchFoundation": {
    "issue": "#2115, #2116, #2117, #2118",
    "parent": "#2114"
  }
}
