{
  "apiVersion": "flow.aiwg.io/v1alpha1", "kind": "FlowGraph", "metadata": { "name": "storage-migration-fortemi" },
  "spec": {
    "description": "Filesystem to Fortemi Server migration with snapshot, bounded copy, reconciliation, verification, approval, cutover, smoke, and rollback readiness.",
    "entry": ["snapshot"],
    "candidates": [{ "id": "aiwg:function:2000000000000001", "kind": "function" }, { "id": "aiwg:tool:2000000000000002", "kind": "tool" }],
    "state": { "fields": [{ "name": "lag", "schema": { "type": "integer" }, "reducer": "replace", "initial": 3 }] },
    "permissions": ["storage:read", "storage:write", "routing:write"],
    "capabilities": [{ "id": "migration-read", "permissions": ["storage:read"], "sideEffectMode": "none" }, { "id": "migration-write", "permissions": ["storage:write"], "sideEffectMode": "idempotent" }, { "id": "cutover", "permissions": ["routing:write"], "sideEffectMode": "approval-required", "approvalGate": "approve" }],
    "ceilings": { "activations": 20, "tokens": 20000, "costUsd": 3, "timeMs": 300000, "concurrency": 4 },
    "nodes": [
      { "id": "snapshot", "kind": "function", "ref": "aiwg:function:2000000000000001", "deterministic": true, "inputs": [{ "name": "source", "schema": { "type": "string" }, "value": "json-filesystem" }, { "name": "destinations", "schema": { "type": "object", "required": ["primary", "advancedVariant"] }, "value": { "primary": "fortemi-server", "advancedVariant": "postgres-direct" } }], "outputs": [{ "name": "manifest", "schema": { "type": "object", "required": ["snapshot", "cursor", "digest"] } }], "capabilities": ["migration-read"], "permissions": ["storage:read"], "sideEffectMode": "none" },
      { "id": "parallel-copy", "kind": "tool", "ref": "aiwg:tool:2000000000000002", "dependsOn": ["snapshot"], "inputs": [{ "name": "manifest", "schema": { "type": "object" }, "from": "snapshot.manifest" }], "outputs": [{ "name": "receipt", "schema": { "type": "object", "required": ["committed", "idempotencyKey", "checkpoint"] } }], "scope": { "resources": ["workers:4", "queue:bounded", "primary:fortemi-server", "advanced-variant:postgres-direct"] }, "capabilities": ["migration-write"], "permissions": ["storage:write"], "sideEffectMode": "idempotent", "idempotencyKey": "migration-copy-v1" },
      { "id": "reconcile", "kind": "tool", "ref": "aiwg:tool:2000000000000002", "dependsOn": ["parallel-copy"], "inputs": [{ "name": "receipt", "schema": { "type": "object" }, "from": "parallel-copy.receipt" }, { "name": "previous-lag", "schema": { "type": "integer" }, "state": "lag" }], "outputs": [{ "name": "remaining", "schema": { "type": "integer" }, "state": "lag" }, { "name": "receipt", "schema": { "type": "object", "required": ["updates", "deletes", "duplicates"] } }], "capabilities": ["migration-write"], "permissions": ["storage:write"], "sideEffectMode": "idempotent", "idempotencyKey": "migration-reconcile-v1" },
      { "id": "verify", "kind": "function", "ref": "aiwg:function:2000000000000001", "deterministic": true, "inputs": [{ "name": "remaining", "schema": { "type": "integer" }, "state": "lag" }, { "name": "reconcile-receipt", "schema": { "type": "object" }, "from": "reconcile.receipt" }], "outputs": [{ "name": "parity", "schema": { "type": "object", "required": ["valid", "count", "digest", "edges"] } }], "capabilities": ["migration-read"], "permissions": ["storage:read"], "sideEffectMode": "none" },
      { "id": "approve", "kind": "gate", "inputs": [{ "name": "parity", "schema": { "type": "object" }, "from": "verify.parity" }], "outputs": [], "capabilities": [], "permissions": [], "sideEffectMode": "none" },
      { "id": "cutover", "kind": "tool", "ref": "aiwg:tool:2000000000000002", "inputs": [{ "name": "parity", "schema": { "type": "object" }, "from": "verify.parity" }], "outputs": [{ "name": "routing-receipt", "schema": { "type": "object", "required": ["reads", "writes", "approvalDigest"] } }], "capabilities": ["cutover"], "permissions": ["routing:write"], "sideEffectMode": "approval-required", "approvalGate": "approve" },
      { "id": "smoke", "kind": "function", "ref": "aiwg:function:2000000000000001", "deterministic": true, "inputs": [{ "name": "routing", "schema": { "type": "object" }, "from": "cutover.routing-receipt" }], "outputs": [{ "name": "result", "schema": { "type": "object", "required": ["passed"] } }], "capabilities": ["migration-read"], "permissions": ["storage:read"], "sideEffectMode": "none" },
      { "id": "rollback-ready", "kind": "function", "ref": "aiwg:function:2000000000000001", "deterministic": true, "inputs": [{ "name": "smoke", "schema": { "type": "object" }, "from": "smoke.result" }], "outputs": [{ "name": "result", "schema": { "type": "object", "required": ["sourceRetained", "windowEndsAt"] } }], "capabilities": [], "permissions": [], "sideEffectMode": "none" }
    ],
    "routes": [{ "from": "snapshot", "to": "parallel-copy" }, { "from": "parallel-copy", "to": "reconcile" }, { "id": "drain-lag", "from": "reconcile", "to": "reconcile", "when": { "language": "cel", "expression": "state.lag > 0" }, "guard": { "language": "cel", "expression": "state.lag > 0" }, "progress": { "state": "lag", "direction": "decrease" }, "maxIterations": 5 }, { "id": "lag-drained", "from": "reconcile", "to": "verify", "when": { "language": "cel", "expression": "state.lag == 0" } }, { "from": "verify", "to": "approve" }, { "from": "approve", "to": "cutover" }, { "from": "cutover", "to": "smoke" }, { "from": "smoke", "to": "rollback-ready" }],
    "joins": [], "failure": { "onNodeFailure": "fail", "maxFailures": 0 },
    "output": { "mode": "typed-terminal-failure", "from": "rollback-ready.result", "schema": { "type": "object", "required": ["sourceRetained", "windowEndsAt"] }, "failureSchema": { "type": "object", "required": ["code"] } },
    "trace": { "level": "bindings", "redact": [] }
  }
}
