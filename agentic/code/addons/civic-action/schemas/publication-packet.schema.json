{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/civic-action/v1/publication-packet.schema.json",
  "title": "Civic publication review packet",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "artifact_id", "artifact_hash", "sections", "links", "claims", "upstream_gates", "privacy", "accessibility", "publication_state", "correction", "deployment", "human_review"],
  "properties": {
    "schema": {"const": "aiwg.civic.publication-packet.v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "content_length"], "properties": {"id": {"type": "string", "minLength": 1}, "content_length": {"type": "integer", "minimum": 1}}}},
    "links": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "http_status", "material"], "properties": {"url": {"type": "string", "format": "uri"}, "http_status": {"type": "integer", "minimum": 100, "maximum": 599}, "material": {"type": "boolean"}}}},
    "claims": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["claim_id", "material", "status", "attributed", "freshness_state", "citations"], "properties": {"claim_id": {"type": "string", "minLength": 1}, "material": {"type": "boolean"}, "status": {"enum": ["official_record", "reported_allegation", "verified_fact", "analysis", "opinion", "unknown_or_disputed"]}, "attributed": {"type": "boolean"}, "freshness_state": {"enum": ["fresh", "due", "stale", "expired", "unknown", "unavailable"]}, "citations": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "upstream_gates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gate_id", "status"], "properties": {"gate_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "warn", "block"]}}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["status", "reviewer"], "properties": {"status": {"enum": ["pass", "warn", "block", "pending"]}, "reviewer": {"type": ["string", "null"]}}},
    "accessibility": {"type": "object", "additionalProperties": false, "required": ["automated_status", "manual_status", "reviewer"], "properties": {"automated_status": {"enum": ["pass", "fail", "not_run"]}, "manual_status": {"enum": ["pass", "fail", "pending"]}, "reviewer": {"type": ["string", "null"]}}},
    "publication_state": {"enum": ["usable", "withheld", "canceled", "superseded"]},
    "correction": {"type": "object", "additionalProperties": false, "required": ["open_blocking", "pending_reindex_targets"], "properties": {"open_blocking": {"type": "boolean"}, "pending_reindex_targets": {"type": "integer", "minimum": 0}}},
    "deployment": {"type": "object", "additionalProperties": false, "required": ["last_good_copy_state", "verification_state", "adapter"], "properties": {"last_good_copy_state": {"enum": ["available", "first_publication", "missing"]}, "verification_state": {"enum": ["pass", "fail", "pending"]}, "adapter": {"type": "string", "minLength": 1}}},
    "human_review": {"type": "object", "additionalProperties": false, "required": ["state", "reviewer", "artifact_hash"], "properties": {"state": {"enum": ["approved", "rejected", "pending"]}, "reviewer": {"type": ["string", "null"]}, "artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}
  }
}
