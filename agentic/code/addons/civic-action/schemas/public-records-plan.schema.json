{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/civic-action/v1/public-records-plan.schema.json",
  "title": "Public records request plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "request_id", "status", "jurisdiction_profile", "recipient", "scope", "fees", "privacy", "human_review", "automatic_submission"],
  "properties": {
    "schema": {"const": "aiwg.civic.public-records-plan.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["researching", "draft", "human_review", "ready", "submitted", "acknowledged", "processing", "partial_response", "completed", "denied", "closed"]},
    "jurisdiction_profile": {"type": "object", "additionalProperties": false, "required": ["jurisdiction", "law_name", "law_url", "reviewed_at", "reviewer"], "properties": {"jurisdiction": {"type": "string", "minLength": 1}, "law_name": {"type": "string", "minLength": 1}, "law_url": {"type": "string", "format": "uri"}, "agency_instructions_url": {"type": ["string", "null"], "format": "uri"}, "reviewed_at": {"type": "string", "format": "date-time"}, "reviewer": {"type": "string", "minLength": 1}}},
    "recipient": {"type": "object", "additionalProperties": false, "required": ["agency", "component", "contact_source_url", "submission_channels"], "properties": {"agency": {"type": "string", "minLength": 1}, "component": {"type": "string", "minLength": 1}, "contact_source_url": {"type": "string", "format": "uri"}, "submission_channels": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["records_description", "date_start", "date_end", "record_types", "exclusions"], "properties": {"records_description": {"type": "string", "minLength": 1}, "date_start": {"type": ["string", "null"], "format": "date"}, "date_end": {"type": ["string", "null"], "format": "date"}, "record_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "search_terms": {"type": "array", "items": {"type": "string"}}, "exclusions": {"type": "array", "items": {"type": "string"}}}},
    "fees": {"type": "object", "additionalProperties": false, "required": ["fee_ceiling", "waiver_requested"], "properties": {"fee_ceiling": {"type": ["number", "null"], "minimum": 0}, "waiver_requested": {"type": "boolean"}, "waiver_rationale": {"type": ["string", "null"]}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["third_party_personal_data", "minimization_notes"], "properties": {"third_party_personal_data": {"type": "boolean"}, "minimization_notes": {"type": "string"}, "sensitive_terms": {"type": "array", "items": {"type": "string"}}}},
    "human_review": {"type": "object", "additionalProperties": false, "required": ["state", "reviewer", "artifact_hash"], "properties": {"state": {"enum": ["approved", "rejected", "pending"]}, "reviewer": {"type": ["string", "null"]}, "artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "automatic_submission": {"const": false}
  }
}
