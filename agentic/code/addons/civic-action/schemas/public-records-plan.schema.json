{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/civic-action/v1/public-records-plan.schema.json",
  "title": "Public records request plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "request_id", "question", "urgency", "status", "jurisdiction_profile", "recipient", "scope", "requested_formats", "delivery", "fees", "expedition", "privacy", "tracking", "ingestion", "provenance", "human_review", "automatic_submission"],
  "properties": {
    "schema": {"const": "aiwg.civic.public-records-plan.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "urgency": {"enum": ["routine", "time_sensitive", "expedited_requested", "unknown"]},
    "status": {"enum": ["researching", "draft", "human_review", "ready", "submitted", "acknowledged", "clarification_requested", "fee_issue", "processing", "partial_response", "completed", "denied", "appeal_considered", "closed"]},
    "jurisdiction_profile": {"type": "object", "additionalProperties": false, "required": ["jurisdiction", "law_name", "law_url", "reviewed_at", "reviewer"], "properties": {"jurisdiction": {"type": "string", "minLength": 1}, "law_name": {"type": "string", "minLength": 1}, "law_url": {"type": "string", "format": "uri"}, "agency_instructions_url": {"type": ["string", "null"], "format": "uri"}, "reviewed_at": {"type": "string", "format": "date-time"}, "reviewer": {"type": "string", "minLength": 1}}},
    "recipient": {"type": "object", "additionalProperties": false, "required": ["agency", "component", "custodian", "contact_source_url", "submission_channels"], "properties": {"agency": {"type": "string", "minLength": 1}, "component": {"type": "string", "minLength": 1}, "custodian": {"type": ["string", "null"]}, "contact_source_url": {"type": "string", "format": "uri"}, "submission_channels": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["records_description", "subject", "date_start", "date_end", "record_types", "likely_custodians", "systems_or_locations", "search_terms", "exclusions"], "properties": {"records_description": {"type": "string", "minLength": 1}, "subject": {"type": "string", "minLength": 1}, "date_start": {"type": ["string", "null"], "format": "date"}, "date_end": {"type": ["string", "null"], "format": "date"}, "record_types": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "likely_custodians": {"type": "array", "items": {"type": "string"}}, "systems_or_locations": {"type": "array", "items": {"type": "string"}}, "search_terms": {"type": "array", "items": {"type": "string"}}, "exclusions": {"type": "array", "items": {"type": "string"}}}},
    "requested_formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["preferred_format", "delivery_method", "accessibility_needs", "rolling_production_requested"], "properties": {"preferred_format": {"type": "string", "minLength": 1}, "delivery_method": {"type": "string", "minLength": 1}, "accessibility_needs": {"type": ["string", "null"]}, "rolling_production_requested": {"type": "boolean"}}},
    "fees": {"type": "object", "additionalProperties": false, "required": ["requester_category_claim", "fee_ceiling", "advance_notice_threshold", "waiver_requested", "waiver_rationale", "fee_rule_url"], "properties": {"requester_category_claim": {"type": ["string", "null"]}, "fee_ceiling": {"type": ["number", "null"], "minimum": 0}, "advance_notice_threshold": {"type": ["number", "null"], "minimum": 0}, "waiver_requested": {"type": "boolean"}, "waiver_rationale": {"type": ["string", "null"]}, "fee_rule_url": {"type": ["string", "null"], "format": "uri"}}},
    "expedition": {"type": "object", "additionalProperties": false, "required": ["requested", "basis", "supporting_facts", "certification_text", "rule_url"], "properties": {"requested": {"type": "boolean"}, "basis": {"type": ["string", "null"]}, "supporting_facts": {"type": "array", "items": {"type": "string"}}, "certification_text": {"type": ["string", "null"]}, "rule_url": {"type": ["string", "null"], "format": "uri"}}},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["request_concerns_self", "third_party_personal_data", "consent_or_identity_requirements", "minimization_notes", "sensitive_terms"], "properties": {"request_concerns_self": {"type": "boolean"}, "third_party_personal_data": {"type": "boolean"}, "consent_or_identity_requirements": {"type": ["string", "null"]}, "minimization_notes": {"type": "string"}, "sensitive_terms": {"type": "array", "items": {"type": "string"}}}},
    "tracking": {"type": "object", "additionalProperties": false, "required": ["draft_version", "sent_at", "submission_proof", "agency_tracking_number", "acknowledged_at", "due_date_observed", "due_date_calculated", "estimated_completion", "fee_status", "correspondence_log", "response_received_at", "disposition", "exemptions_asserted", "redactions_marked", "withheld_volume", "appeal_information", "response_artifacts", "revision_deadline", "appeal_deadline", "investigation_link"], "properties": {"draft_version": {"type": "string", "minLength": 1}, "sent_at": {"type": ["string", "null"], "format": "date-time"}, "submission_proof": {"type": ["string", "null"]}, "agency_tracking_number": {"type": ["string", "null"]}, "acknowledged_at": {"type": ["string", "null"], "format": "date-time"}, "due_date_observed": {"type": ["string", "null"], "format": "date"}, "due_date_calculated": {"type": ["string", "null"], "format": "date"}, "estimated_completion": {"type": ["string", "null"], "format": "date"}, "fee_status": {"enum": ["not_applicable", "pending", "quoted", "approved", "disputed", "paid", "waived"]}, "correspondence_log": {"type": "array", "items": {"type": "string"}}, "response_received_at": {"type": ["string", "null"], "format": "date-time"}, "disposition": {"enum": ["none", "granted", "partial", "denied", "referred", "no_records", "unknown"]}, "exemptions_asserted": {"type": "array", "items": {"type": "string"}}, "redactions_marked": {"type": "boolean"}, "withheld_volume": {"type": ["string", "null"]}, "appeal_information": {"type": ["string", "null"]}, "response_artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "media_type", "source_hash", "ingestion_state"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "source_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "ingestion_state": {"enum": ["quarantined", "verified", "linked", "rejected"]}}}}, "revision_deadline": {"type": ["string", "null"], "format": "date"}, "appeal_deadline": {"type": ["string", "null"], "format": "date"}, "investigation_link": {"type": ["string", "null"], "format": "uri"}}},
    "ingestion": {"type": "object", "additionalProperties": false, "required": ["supported_artifact_classes", "preserve_originals", "reverse_redactions"], "properties": {"supported_artifact_classes": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["pdf", "scan", "email", "spreadsheet", "attachment"]}}, "preserve_originals": {"const": true}, "reverse_redactions": {"const": false}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["sources", "drafted_by", "reviewed_by", "revision_of", "generated_at"], "properties": {"sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "drafted_by": {"type": "string", "minLength": 1}, "reviewed_by": {"type": ["string", "null"]}, "revision_of": {"type": ["string", "null"]}, "generated_at": {"type": "string", "format": "date-time"}}},
    "human_review": {"type": "object", "additionalProperties": false, "required": ["state", "reviewer", "artifact_hash"], "properties": {"state": {"enum": ["approved", "rejected", "pending"]}, "reviewer": {"type": ["string", "null"]}, "artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}},
    "automatic_submission": {"const": false}
  }
}
