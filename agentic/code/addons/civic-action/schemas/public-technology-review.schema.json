{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/civic-action/v1/public-technology-review.schema.json",
  "title": "Public technology procurement review",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "review_id", "jurisdiction_profile", "source_class_inventory", "evidence", "risks", "handoffs", "award_recommendation", "human_review"],
  "properties": {
    "schema": {"const": "aiwg.civic.public-technology-review.v1"},
    "review_id": {"type": "string", "minLength": 1},
    "jurisdiction_profile": {"type": "string", "minLength": 1},
    "source_class_inventory": {"type": "object", "additionalProperties": false, "required": ["rfp", "bid", "contract", "purchase_order", "grant", "policy", "packet", "minutes", "renewal", "invoice", "public_comment"], "properties": {"rfp": {"$ref": "#/definitions/inventoryState"}, "bid": {"$ref": "#/definitions/inventoryState"}, "contract": {"$ref": "#/definitions/inventoryState"}, "purchase_order": {"$ref": "#/definitions/inventoryState"}, "grant": {"$ref": "#/definitions/inventoryState"}, "policy": {"$ref": "#/definitions/inventoryState"}, "packet": {"$ref": "#/definitions/inventoryState"}, "minutes": {"$ref": "#/definitions/inventoryState"}, "renewal": {"$ref": "#/definitions/inventoryState"}, "invoice": {"$ref": "#/definitions/inventoryState"}, "public_comment": {"$ref": "#/definitions/inventoryState"}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "claim", "claimant", "artifact_class", "source_id", "source_authority", "selector", "date", "jurisdiction", "public_release_state", "verification_state", "supports_or_contradicts", "review_notes"], "properties": {"evidence_id": {"type": "string"}, "claim": {"type": "string"}, "claimant": {"type": ["string", "null"]}, "artifact_class": {"enum": ["need", "planning", "market_research", "rfp", "bid", "contract", "purchase_order", "grant", "policy", "packet", "minutes", "renewal", "invoice", "public_comment", "solicitation", "source_selection", "responsibility", "award", "administration", "oversight", "public_release"]}, "source_id": {"type": "string"}, "source_authority": {"const": "primary_record"}, "selector": {"type": "string"}, "date": {"type": ["string", "null"], "format": "date"}, "jurisdiction": {"type": "string", "minLength": 1}, "public_release_state": {"enum": ["public", "protected", "unknown"]}, "verification_state": {"enum": ["verified", "unverified", "disputed"]}, "supports_or_contradicts": {"enum": ["supports", "contradicts", "mixed", "context_only"]}, "review_notes": {"type": "string"}}}},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["risk_id", "category", "condition", "consequence", "affected_service_or_population", "evidence_ids", "likelihood", "impact", "uncertainty", "rationale", "owner", "mitigation", "verification_method", "residual_risk", "status", "reviewed_at"], "properties": {"risk_id": {"type": "string"}, "category": {"enum": ["data_collection", "data_retention", "access_control", "data_sharing", "ai_capability_claim", "auditability", "oversight", "accessibility", "privacy", "security_supply_chain", "interoperability_lock_in", "resilience_continuity", "fiscal_schedule_performance", "supplier_responsibility"]}, "condition": {"type": "string"}, "consequence": {"type": "string"}, "affected_service_or_population": {"type": "string"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "likelihood": {"enum": ["low", "medium", "high", "unknown"]}, "impact": {"enum": ["low", "medium", "high", "unknown"]}, "uncertainty": {"type": "string"}, "rationale": {"type": "string"}, "owner": {"type": ["string", "null"]}, "mitigation": {"type": "string"}, "verification_method": {"type": "string"}, "residual_risk": {"enum": ["low", "medium", "high", "unknown"]}, "status": {"enum": ["open", "mitigated", "accepted", "closed"]}, "reviewed_at": {"type": ["string", "null"], "format": "date-time"}}}},
    "handoffs": {"type": "object", "additionalProperties": false, "required": ["records_request", "meeting_analysis", "publication"], "properties": {"records_request": {"$ref": "#/definitions/handoffState"}, "meeting_analysis": {"$ref": "#/definitions/handoffState"}, "publication": {"$ref": "#/definitions/handoffState"}}},
    "award_recommendation": {"const": null},
    "human_review": {"type": "object", "additionalProperties": false, "required": ["state", "reviewer", "artifact_hash"], "properties": {"state": {"enum": ["pending", "approved", "rejected"]}, "reviewer": {"type": ["string", "null"]}, "artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}
  },
  "definitions": {
    "inventoryState": {"enum": ["present", "not_applicable", "requested", "unknown", "protected"]},
    "handoffState": {"enum": ["not_needed", "pending", "ready", "complete"]}
  }
}
