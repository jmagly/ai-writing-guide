{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwg.io/schemas/testing/test-coverage.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "format": {
      "enum": [
        "canonical",
        "istanbul"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "root",
        "sourceFiles",
        "missingFiles",
        "extraFiles"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lines": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "covered": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "covered",
                      "total"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "statements": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "covered": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "covered",
                      "total"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "functions": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "covered": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "covered",
                      "total"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "branches": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "covered": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "covered",
                      "total"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "lines",
              "statements",
              "functions",
              "branches"
            ]
          }
        },
        "required": [
          "path",
          "metrics"
        ]
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "covered",
                "total"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "statements": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "covered",
                "total"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "functions": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "covered",
                "total"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "branches": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "covered": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "covered",
                "total"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lines",
        "statements",
        "functions",
        "branches"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  },
  "required": [
    "provider",
    "version",
    "format",
    "scope",
    "files",
    "totals",
    "complete",
    "errors"
  ]
}
