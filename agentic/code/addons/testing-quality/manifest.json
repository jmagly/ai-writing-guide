{
  "id": "testing-quality",
  "name": "testing-quality",
  "version": "2.0.0",
  "description": "Evidence-bound test conformance, platform protocols, normalization transactions and research-guided testing workflows",
  "category": "sdlc",
  "skills": [
    "tdd-enforce",
    "mutation-test",
    "flaky-detect",
    "flaky-fix",
    "generate-factory",
    "test-sync",
    "test-conformance",
    "test-normalize",
    "test-platform-research"
  ],
  "dependencies": [],
  "research_basis": {
    "tdd": {
      "source": "Kent Beck (2002)",
      "reference": "Test-Driven Development by Example"
    },
    "coverage": {
      "source": "Google Testing Blog (2010)",
      "reference": "https://testing.googleblog.com/2010/07/code-coverage-goal-80-and-no-less.html"
    },
    "mutation": {
      "source": "ICST Mutation Workshop",
      "reference": "https://conf.researchr.org/home/icst-2024/mutation-2024"
    },
    "flaky": {
      "source": "Google (2016) + FlaKat (2024)",
      "reference": "https://arxiv.org/abs/2403.01003"
    },
    "factories": {
      "source": "ThoughtBot FactoryBot + Faker.js",
      "reference": "https://fakerjs.dev/"
    }
  },
  "type": "addon",
  "core": false,
  "autoInstall": false,
  "agents": [
    "conformance-steward",
    "test-oracle-reviewer",
    "test-normalization-engineer"
  ],
  "rules": [
    "test-conformance-evidence"
  ],
  "templates": [
    "protocol-review",
    "test-review",
    "conformance-report",
    "normalization-plan",
    "tool-recommendation",
    "adapter-qualification"
  ],
  "flows": [
    "test-conformance-audit",
    "test-conformance-normalize",
    "test-platform-qualification"
  ],
  "entry": {
    "agents": "agents/",
    "skills": "skills/",
    "rules": "rules/",
    "templates": "templates/",
    "flows": "flows/",
    "schemas": "schemas/"
  },
  "cli_commands": {
    "namespace": "test-conformance",
    "description": "Evidence-bound testing conformance and reversible normalization",
    "entry": "commands/",
    "subcommands": {
      "init": {
        "file": "test-conformance.mjs",
        "description": "Create a platform protocol for review"
      },
      "inventory": {
        "file": "test-conformance.mjs",
        "description": "Hash source, configuration and candidate tests"
      },
      "sample": {
        "file": "test-conformance.mjs",
        "description": "Draw a reproducible stratified review sample"
      },
      "collect": {
        "file": "test-conformance.mjs",
        "description": "Collect runner evidence"
      },
      "assess": {
        "file": "test-conformance.mjs",
        "description": "Assess current evidence and complete reviews"
      },
      "plan": {
        "file": "test-conformance.mjs",
        "description": "Create a guarded normalization plan"
      },
      "apply": {
        "file": "test-conformance.mjs",
        "description": "Apply a plan with a recovery journal"
      },
      "rollback": {
        "file": "test-conformance.mjs",
        "description": "Restore an applied plan without overwriting drift"
      },
      "templates": {
        "file": "test-conformance.mjs",
        "description": "List, develop or plan deployment of templates"
      },
      "research": {
        "file": "test-conformance.mjs",
        "description": "Find corpus evidence and platform tools"
      },
      "validate": {
        "file": "test-conformance.mjs",
        "description": "Validate an artifact against a strict schema"
      },
      "report": {
        "file": "test-conformance.mjs",
        "description": "Render a conformance assessment"
      }
    }
  }
}
