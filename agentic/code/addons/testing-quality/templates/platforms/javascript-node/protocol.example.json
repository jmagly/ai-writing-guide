{
  "apiVersion": "testing.aiwg.io/v1",
  "kind": "TestConformanceProtocol",
  "metadata": {
    "name": "javascript-node-example",
    "description": "TODO assumptions: No authoritative collect-only adapter is bundled; native default selection can differ from candidate globs."
  },
  "spec": {
    "platform": "javascript-node",
    "system": "TODO: identify actual system and source or installed-artifact boundary",
    "source": {
      "include": [
        "src/**/*.{js,mjs,cjs,ts}"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**",
        "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
        "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
      ]
    },
    "tests": {
      "include": [
        "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
        "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**"
      ]
    },
    "areas": [
      {
        "id": "tests",
        "include": [
          "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
          "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
        ]
      }
    ],
    "lanes": [
      {
        "id": "default",
        "runner": "node",
        "include": [
          "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
          "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
        ],
        "exclude": [
          "**/node_modules/**",
          "**/.git/**",
          "**/.aiwg/**",
          "**/dist/**",
          "**/build/**",
          "**/coverage/**",
          "**/.venv/**",
          "**/venv/**",
          "**/target/**",
          "**/bin/**",
          "**/obj/**",
          "**/__pycache__/**"
        ],
        "command": {
          "argv": [
            "node",
            "--test",
            "--test-reporter=tap"
          ],
          "timeoutMs": 300000
        },
        "result": {
          "format": "node-tap"
        },
        "required": true,
        "negativeControls": [],
        "versionCommand": [
          "node",
          "--version"
        ]
      }
    ],
    "policy": {
      "requireDiscovery": true,
      "requireReview": true,
      "requireNegativeControls": true,
      "allowSkipped": false,
      "coverageThresholds": {},
      "maxFiles": 100000,
      "maxFileBytes": 1048576,
      "maxOutputBytes": 10485760
    },
    "research": {
      "paths": [
        ".aiwg/research/findings",
        ".aiwg/research/synthesis",
        ".aiwg/research/knowledge"
      ],
      "allowWeb": false
    }
  }
}
