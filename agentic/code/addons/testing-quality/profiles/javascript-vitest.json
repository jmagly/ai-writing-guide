{
  "schemaVersion": 1,
  "id": "javascript-vitest",
  "name": "Vitest",
  "status": "researched-not-qualified",
  "compatibility": "not-verified",
  "assumptions": [
    "Vitest list uses real runner collection and imports target modules; qualify installed CLI semantics. Native Node tests need their own lane.",
    "TODO: review candidate scope, thresholds, skips, report adapter and minimum test obligations before execution."
  ],
  "protocolSpec": {
    "platform": "javascript-vitest",
    "system": "TODO: identify actual system and source or installed-artifact boundary",
    "source": {
      "include": [
        "src/**/*.{ts,tsx,js,mjs,cjs,jsx}"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**",
        "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
        "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
      ]
    },
    "tests": {
      "include": [
        "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
        "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/.aiwg/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/.venv/**",
        "**/venv/**",
        "**/target/**",
        "**/bin/**",
        "**/obj/**",
        "**/__pycache__/**"
      ]
    },
    "areas": [
      {
        "id": "tests",
        "include": [
          "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
          "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
        ]
      }
    ],
    "lanes": [
      {
        "id": "default",
        "runner": "vitest",
        "include": [
          "**/*.test.{js,mjs,cjs,ts,tsx,jsx}",
          "**/*.spec.{js,mjs,cjs,ts,tsx,jsx}"
        ],
        "exclude": [
          "**/node_modules/**",
          "**/.git/**",
          "**/.aiwg/**",
          "**/dist/**",
          "**/build/**",
          "**/coverage/**",
          "**/.venv/**",
          "**/venv/**",
          "**/target/**",
          "**/bin/**",
          "**/obj/**",
          "**/__pycache__/**"
        ],
        "command": {
          "argv": [
            "node",
            "node_modules/vitest/vitest.mjs",
            "run",
            "--reporter=json",
            "--outputFile=.aiwg/testing/conformance/raw/{runId}/vitest.json"
          ],
          "timeoutMs": 300000
        },
        "result": {
          "format": "vitest",
          "path": ".aiwg/testing/conformance/raw/{runId}/vitest.json"
        },
        "required": true,
        "negativeControls": [],
        "versionCommand": [
          "node",
          "node_modules/vitest/vitest.mjs",
          "--version"
        ],
        "discovery": {
          "command": {
            "argv": [
              "node",
              "node_modules/vitest/vitest.mjs",
              "list",
              "--json=.aiwg/testing/conformance/raw/{runId}/vitest-discovery.json"
            ],
            "timeoutMs": 300000
          },
          "result": {
            "format": "vitest",
            "path": ".aiwg/testing/conformance/raw/{runId}/vitest-discovery.json"
          }
        }
      }
    ],
    "policy": {
      "requireDiscovery": true,
      "requireReview": true,
      "requireNegativeControls": true,
      "allowSkipped": false,
      "coverageThresholds": {},
      "maxFiles": 100000,
      "maxFileBytes": 1048576,
      "maxOutputBytes": 10485760
    },
    "research": {
      "paths": [
        ".aiwg/research/findings",
        ".aiwg/research/synthesis",
        ".aiwg/research/knowledge"
      ],
      "allowWeb": false
    }
  },
  "templates": [
    {
      "source": "templates/platforms/javascript-vitest/RESEARCH.md",
      "destination": ".aiwg/testing/conformance/examples/javascript-vitest/RESEARCH.md",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    },
    {
      "source": "templates/platforms/javascript-vitest/protocol.example.json",
      "destination": ".aiwg/testing/conformance/examples/javascript-vitest/protocol.example.json",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    },
    {
      "source": "templates/platforms/javascript-vitest/test-review.example.md",
      "destination": ".aiwg/testing/conformance/examples/javascript-vitest/test-review.example.md",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    },
    {
      "source": "templates/platforms/javascript-vitest/vitest.config.example.mjs",
      "destination": ".aiwg/testing/conformance/examples/javascript-vitest/vitest.config.example.mjs",
      "purpose": "review-only example; TODO assumptions require target-specific normalization"
    }
  ]
}
