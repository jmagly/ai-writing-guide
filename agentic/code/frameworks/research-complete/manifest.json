{
  "id": "research-complete",
  "type": "framework",
  "name": "Research Complete",
  "version": "1.0.0",
  "description": "Research workflow framework for discovery, acquisition, synthesis, citation, quality, and archival operations.",
  "modeAliases": [
    "research"
  ],
  "entry": {
    "agents": "agents",
    "skills": "skills",
    "templates": "templates",
    "lint": "lint"
  },
  "workspace": {
    "subdirs": [
      "repo",
      "corpus",
      "working",
      "archive"
    ]
  },
  "memory": {
    "creates": [
      {
        "path": ".aiwg/frameworks/research-complete/",
        "description": "Research root directory"
      },
      {
        "path": ".aiwg/frameworks/research-complete/workflows/",
        "description": "Active research workflow state"
      },
      {
        "path": ".aiwg/frameworks/research-complete/reports/",
        "description": "Generated research reports"
      },
      {
        "path": ".aiwg/frameworks/research-complete/findings/",
        "description": "Research finding notes (REF-NNN.md)"
      },
      {
        "path": ".aiwg/frameworks/research-complete/sources/",
        "description": "Source documents and PDFs"
      },
      {
        "path": ".aiwg/frameworks/research-complete/archives/",
        "description": "Archival artifacts"
      },
      {
        "path": ".aiwg/frameworks/research-complete/synthesis/",
        "description": "Synthesis and gap analysis"
      },
      {
        "path": ".aiwg/frameworks/research-complete/provenance/",
        "description": "W3C PROV provenance records"
      },
      {
        "path": ".aiwg/frameworks/research-complete/knowledge/",
        "description": "Knowledge base and lit notes"
      }
    ],
    "topology": {
      "namespace": ".aiwg/research",
      "rawSources": ".aiwg/research/sources",
      "derivedPages": {
        "summary": ".aiwg/research/findings",
        "entity": ".aiwg/research/knowledge/entities",
        "concept": ".aiwg/research/knowledge/concepts",
        "synthesis": ".aiwg/research/synthesis"
      },
      "index": ".aiwg/research/index.md",
      "log": ".aiwg/research/.log.jsonl",
      "crossRefStyle": "at-mention",
      "pageTemplate": "templates/research-page.md",
      "ingestRequires": [
        "provenance",
        "grade-quality"
      ],
      "lintRules": [
        "citation-guard",
        "link-check",
        "mention-lint"
      ]
    }
  },
  "extensions": {
    "corpus-templates": {
      "path": "agentic/code/extensions/corpus-templates",
      "type": "extension",
      "requires": [
        "research-complete"
      ],
      "description": "Multi-tier reference-doc templates (canonical 15-section + expanded 21-section) for the REF-XXX corpus convention",
      "scope": "corpus-convention"
    },
    "research-brainstorming": {
      "path": "agentic/code/extensions/research-brainstorming",
      "type": "extension",
      "requires": [
        "research-complete",
        "knowledge-base",
        "semantic-memory"
      ],
      "optional": [
        "llm-wiki"
      ],
      "description": "Free-form research brainstorming over wiki memory and KB graph traversal, with promotion into structured research artifacts",
      "scope": "research-ideation"
    }
  }
}
